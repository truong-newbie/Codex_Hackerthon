# ShiftLens Backend Configuration (.env)
# Copy this file to backend/.env before starting the FastAPI server

ENVIRONMENT=development
DEMO_MODE=true
# Required in production: comma-separated exact origins, e.g. https://studio.example.com
CORS_ORIGINS=

# AI_MODE: "live" (uses Google Gemini API) or "stub" (offline deterministic fallback)
AI_MODE=stub
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OPERATION_LEASE_SECONDS=90

# Database: defaults to backend/shiftlens.db, independent of launch directory.
# Set an absolute SQLite URL or a PostgreSQL URL to override.
# DATABASE_URL=sqlite:///D:/path/to/shiftlens.db

# JWT Secret Key
SECRET_KEY=shiftlens-default-secret-hackathon-2026
